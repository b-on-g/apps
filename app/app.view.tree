$bog_apps_app $mol_page
	title \Кирилл Новгородцев — веб-приложения
	head /
		<= Title
		<= Tools
	tools /
		<= Sources $mol_link_source
			uri \https://github.com/b-on-g/apps
		<= Status $giper_baza_status
		<= Theme_toggle $bog_theme_toggle
			theme_auto <= Theme
	plugins /
		<= Theme $bog_theme_auto
			theme_light \$mol_theme_calm_light
			theme_dark \$mol_theme_calm_dark
			themes /
				\$mol_theme_calm_light
				\$mol_theme_calm_dark
	Feature* $mol_view
		sub /
			<= Feature_title* $mol_paragraph
				title <= feature_title* \
			<= Feature_text* $mol_paragraph
				title <= feature_text* \
	Case* $mol_view
		sub /
			<= Case_title* $mol_paragraph
				title <= case_title* \
			<= Case_text* $mol_paragraph
				title <= case_text* \
			<= Case_links* $mol_view
				sub /
					<= Case_demo* $mol_link
						uri <= case_demo_uri* \
						target \_blank
						sub /
							\Открыть
					<= Case_source* $mol_link
						uri <= case_source_uri* \
						target \_blank
						sub /
							\Исходники
	Step* $mol_view
		sub /
			<= Step_num* $mol_paragraph
				title <= step_num* \
			<= Step_body* $mol_view
				sub /
					<= Step_title* $mol_paragraph
						title <= step_title* \
					<= Step_text* $mol_paragraph
						title <= step_text* \
	body /
		<= Hero $mol_view
			sub /
				<= Hero_title $mol_paragraph
					title \Веб-приложения, которые работают как нативные
				<= Hero_text $mol_paragraph
					title \Меня зовут Кирилл Новгородцев. Делаю сайты и веб-аппки, которые ставятся на телефон, работают офлайн и не требуют серверной инфраструктуры.
				<= Hero_actions $mol_view
					sub /
						<= Lead_scroll $mol_button_major
							title \Оставить заявку
							click? <=> lead_scroll? null
						<= Tg_link $mol_link
							uri \https://t.me/Dev_cmyser
							target \_blank
							sub /
								\Написать в Telegram
		<= Features $mol_view
			sub /
				<= Features_title $mol_paragraph
					title \Что вы получаете
				<= Features_list $mol_view
					sub <= feature_cards /
		<= Cases $mol_view
			sub /
				<= Cases_title $mol_paragraph
					title \Кейсы
				<= Cases_list $mol_view
					sub <= case_cards /
		<= Process $mol_view
			sub /
				<= Process_title $mol_paragraph
					title \Как идёт работа
				<= Process_list $mol_view
					sub <= step_cards /
		<= Lead_section $mol_view
			sub /
				<= Lead_title $mol_paragraph
					title \Оставить заявку
				<= Lead $bog_apps_lead
		<= Requisites $mol_view
			sub /
				<= Requisites_title $mol_paragraph
					title \Реквизиты
				<= Requisites_text $mol_text
					text \
						\**ИП Новгородцев Кирилл Александрович**
						\
						\ОГРНИП 325350000056770, ИНН 351400789430
						\
						\Почта: [cmyser.fast@mail.ru](mailto:cmyser.fast@mail.ru), Telegram: [@Dev_cmyser](https://t.me/Dev_cmyser)
