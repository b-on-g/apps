$bog_apps_lead $bog_feedback2_form
	feedback_id \apps
	title \Оставить заявку
	prompt \Опишите задачу в паре предложений: что за продукт и для кого. Отвечу в течение дня.
	Entry_my $mol_textarea
		hint \Что нужно сделать?
		value? <=> draft_text? \
	Contact_field $mol_string
		hint \Telegram или email для связи
		value? <=> draft_contact? \
	Submit $mol_button_major
		title <= submit_title \
		click? <=> submit? null
	Sent_note $mol_paragraph
		title \Заявка отправлена. Её можно дописать и обновить — или написать мне напрямую в Telegram.
